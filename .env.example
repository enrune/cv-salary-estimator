# OpenRouter API klíč — získat na https://openrouter.ai (potřeba ~$5 kreditu pro testování)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Volitelné: model, který chceš použít. Default je google/gemini-2.5-flash (rychlý, levný, dobrá čeština).
# Alternativy: anthropic/claude-haiku-4.5, openai/gpt-4o-mini, deepseek/deepseek-chat
OPENROUTER_MODEL=google/gemini-2.5-flash
